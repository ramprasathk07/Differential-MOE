# Copy to .env in the repository root and fill in your W&B API key locally.

# Hugging Face read token (https://huggingface.co/settings/tokens). Optional, but
# streaming SlimPajama's 250 parquet shards anonymously can hit Hub rate limits.
HF_TOKEN=

# Get a key from https://wandb.ai/authorize. Leave blank if already logged in.
WANDB_API_KEY=
WANDB_ENABLED=true
WANDB_PROJECT=latentmoe-fineweb-edu
# Optional: your W&B team/entity slug; blank uses your account's default.
WANDB_ENTITY=
# online uploads metrics; offline stores them locally; disabled turns logging off.
WANDB_MODE=online
# Optional run name, otherwise the YAML run_name is used.
WANDB_NAME=

# MLflow: run + checkpoint lineage (params, scalar metrics, best/snapshot/last
# checkpoints with step, tokens and epoch). Point both the training box and the
# eval PC at one server (e.g. `mlflow server --host 0.0.0.0 --port 5000`) so eval
# results land in the same run; leave blank for MLflow's local default store.
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=diff-moe-L
# Upload best/snapshot weights as artifacts (~4 GB each at L size). Off by default.
MLFLOW_LOG_CHECKPOINTS=false
